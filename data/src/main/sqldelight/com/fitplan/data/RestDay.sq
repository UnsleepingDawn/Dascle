CREATE TABLE rest_day (
    date INTEGER NOT NULL PRIMARY KEY
);

selectAll:
SELECT *
FROM rest_day
ORDER BY date;

selectBetween:
SELECT *
FROM rest_day
WHERE date >= ? AND date < ?
ORDER BY date;

insert:
INSERT OR IGNORE INTO rest_day(date)
VALUES (?);

deleteByDate:
DELETE FROM rest_day
WHERE date = ?;

deleteBetween:
DELETE FROM rest_day
WHERE date >= ? AND date < ?;

-- 顺延：读 / 删「今天及以后」的休息日，好把它们跟着排期一起后移。
selectFrom:
SELECT *
FROM rest_day
WHERE date >= ?
ORDER BY date;

deleteFrom:
DELETE FROM rest_day
WHERE date >= ?;

-- 今日休息（顺延到休息日）：找 [after] 之后最近的一个休息日。
selectNextFrom:
SELECT *
FROM rest_day
WHERE date > ?
ORDER BY date
LIMIT 1;
