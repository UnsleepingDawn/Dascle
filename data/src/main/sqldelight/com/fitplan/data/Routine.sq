CREATE TABLE routine (
    id         INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name       TEXT NOT NULL,
    created_at INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT *
FROM routine
ORDER BY created_at DESC;

selectById:
SELECT *
FROM routine
WHERE id = ?;

countAll:
SELECT count(*)
FROM routine;

insert:
INSERT INTO routine(name, created_at)
VALUES (?, ?);

update:
UPDATE routine
SET name = ?
WHERE id = ?;

deleteById:
DELETE FROM routine
WHERE id = ?;
