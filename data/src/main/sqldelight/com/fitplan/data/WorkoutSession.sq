CREATE TABLE workout_session (
    id          INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    routine_id  INTEGER REFERENCES routine(id) ON DELETE SET NULL,
    name        TEXT NOT NULL DEFAULT '',
    started_at  INTEGER NOT NULL,
    finished_at INTEGER,
    note        TEXT NOT NULL DEFAULT ''
);

CREATE INDEX workout_session_started_at ON workout_session(started_at);

selectAll:
SELECT *
FROM workout_session
ORDER BY started_at DESC;

selectById:
SELECT *
FROM workout_session
WHERE id = ?;

selectLatest:
SELECT *
FROM workout_session
ORDER BY started_at DESC
LIMIT 1;

selectFinished:
SELECT *
FROM workout_session
WHERE finished_at IS NOT NULL
ORDER BY started_at DESC;

selectFinishedBetween:
SELECT *
FROM workout_session
WHERE finished_at IS NOT NULL AND started_at >= ? AND started_at < ?
ORDER BY started_at;

selectUnfinished:
SELECT *
FROM workout_session
WHERE finished_at IS NULL
ORDER BY started_at DESC;

-- 漏练检查：区间内已开始的训练（不看有没有结束），用来判断某天到底练没练。
selectStartedBetween:
SELECT *
FROM workout_session
WHERE started_at >= ? AND started_at < ?
ORDER BY started_at;

-- 统计页的历史列表：每条已结束训练带上完成组数。
selectFinishedWithSummary:
SELECT workout_session.id,
       workout_session.routine_id,
       workout_session.name,
       workout_session.started_at,
       workout_session.finished_at,
       count(workout_set.id) AS completed_sets
FROM workout_session
LEFT JOIN workout_set
    ON workout_set.session_id = workout_session.id AND workout_set.completed = 1
WHERE workout_session.finished_at IS NOT NULL
GROUP BY workout_session.id
ORDER BY workout_session.started_at DESC
LIMIT 50;

countFinished:
SELECT count(*)
FROM workout_session
WHERE finished_at IS NOT NULL;

insert:
INSERT INTO workout_session(routine_id, name, started_at, finished_at, note)
VALUES (?, ?, ?, ?, ?);

finish:
UPDATE workout_session
SET finished_at = ?
WHERE id = ?;

updateName:
UPDATE workout_session
SET name = ?
WHERE id = ?;

updateNote:
UPDATE workout_session
SET note = ?
WHERE id = ?;

deleteById:
DELETE FROM workout_session
WHERE id = ?;
