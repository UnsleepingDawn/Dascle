CREATE TABLE schedule_entry (
    id            INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    routine_id    INTEGER NOT NULL REFERENCES routine(id) ON DELETE CASCADE,
    specific_date INTEGER,
    enabled       INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX schedule_entry_routine_id ON schedule_entry(routine_id);

-- 一天只能有一个训练计划：写排期一律先删掉该日的旧行，这个唯一索引只是兜底。
CREATE UNIQUE INDEX schedule_entry_specific_date ON schedule_entry(specific_date);

selectAll:
SELECT
    schedule_entry.id,
    schedule_entry.routine_id,
    routine.name AS routine_name,
    schedule_entry.specific_date,
    schedule_entry.enabled
FROM schedule_entry
JOIN routine ON routine.id = schedule_entry.routine_id
ORDER BY schedule_entry.specific_date;

selectEnabledBySpecificDate:
SELECT
    schedule_entry.id,
    schedule_entry.routine_id,
    routine.name AS routine_name,
    schedule_entry.specific_date,
    schedule_entry.enabled
FROM schedule_entry
JOIN routine ON routine.id = schedule_entry.routine_id
WHERE schedule_entry.specific_date = ? AND schedule_entry.enabled = 1;

selectByRoutineId:
SELECT *
FROM schedule_entry
WHERE routine_id = ?;

insert:
INSERT INTO schedule_entry(routine_id, specific_date, enabled)
VALUES (?, ?, ?);

-- 编排铺排期：同一天只会出现一次，重复写入由唯一索引挡掉。
insertOnceIgnore:
INSERT OR IGNORE INTO schedule_entry(routine_id, specific_date, enabled)
VALUES (?, ?, 1);

deleteOnceBetween:
DELETE FROM schedule_entry
WHERE specific_date >= ? AND specific_date < ?;

-- 今日休息（顺延到休息日）：读区间内的排期，好把它们整体后移一天。
selectOnceBetween:
SELECT *
FROM schedule_entry
WHERE specific_date >= ? AND specific_date < ?
ORDER BY specific_date;

-- 顺延：读 / 删「今天及以后」的排期，好把它们整体后移。
selectOnceFrom:
SELECT *
FROM schedule_entry
WHERE specific_date >= ?
ORDER BY specific_date;

deleteOnceFrom:
DELETE FROM schedule_entry
WHERE specific_date >= ?;

-- 顺延时原样搬走（保留 enabled），这是它与 insertOnceIgnore 的区别；
-- 日期按 offset 整体后移，与留在原地的行不会撞上唯一索引。
insertOnceWithEnabled:
INSERT OR IGNORE INTO schedule_entry(routine_id, specific_date, enabled)
VALUES (?, ?, ?);

-- 跳过 / 顺延 / 替换该日计划：清掉某一天的排期。
deleteOnceOnDate:
DELETE FROM schedule_entry
WHERE specific_date = ?;

updateEnabled:
UPDATE schedule_entry
SET enabled = ?
WHERE id = ?;

deleteById:
DELETE FROM schedule_entry
WHERE id = ?;

deleteByRoutineId:
DELETE FROM schedule_entry
WHERE routine_id = ?;
