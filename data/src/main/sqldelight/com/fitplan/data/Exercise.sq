CREATE TABLE exercise (
    id                       INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name                     TEXT NOT NULL,
    muscle_group             TEXT NOT NULL,
    equipment                TEXT NOT NULL,
    description              TEXT NOT NULL DEFAULT '',
    is_custom                INTEGER NOT NULL DEFAULT 0,
    created_at               INTEGER NOT NULL DEFAULT 0,
    default_weight           REAL,
    default_duration_seconds INTEGER
);

CREATE INDEX exercise_muscle_group ON exercise(muscle_group);
CREATE INDEX exercise_name ON exercise(name);

selectAll:
SELECT *
FROM exercise
ORDER BY muscle_group, name;

selectById:
SELECT *
FROM exercise
WHERE id = ?;

selectByIds:
SELECT *
FROM exercise
WHERE id IN ?;

selectByMuscleGroup:
SELECT *
FROM exercise
WHERE muscle_group = ?
ORDER BY name;

selectCustom:
SELECT *
FROM exercise
WHERE is_custom = 1
ORDER BY created_at DESC;

selectNonCustomNames:
SELECT name
FROM exercise
WHERE is_custom = 0;

selectNonCustom:
SELECT id, name
FROM exercise
WHERE is_custom = 0;

countAll:
SELECT count(*)
FROM exercise;

insert:
INSERT INTO exercise(
    name, muscle_group, equipment, description, is_custom, created_at, default_weight, default_duration_seconds
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertIgnore:
INSERT OR IGNORE INTO exercise(
    name, muscle_group, equipment, description, is_custom, created_at, default_weight, default_duration_seconds
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- 种子升级时为已存在的内置动作补默认值：只在原来为空时写入，不动用户已有数据。
updateSeedWeight:
UPDATE exercise
SET default_weight = ?
WHERE id = ? AND default_weight IS NULL;

updateSeedDuration:
UPDATE exercise
SET default_duration_seconds = ?
WHERE id = ? AND default_duration_seconds IS NULL;

-- 渐进重量提示点「好的！」：抬高动作库里的默认重量。
updateDefaultWeight:
UPDATE exercise
SET default_weight = ?
WHERE id = ?;

update:
UPDATE exercise
SET name = ?, muscle_group = ?, equipment = ?, description = ?
WHERE id = ?;

deleteById:
DELETE FROM exercise
WHERE id = ?;
